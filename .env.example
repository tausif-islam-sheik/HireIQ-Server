# Database (NeonDB)
DATABASE_URL=postgresql://user:password@localhost:5432/hireiq

# JWT Authentication
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# Redis (Caching & Queues)
REDIS_URL=redis://localhost:6379

# Cloudinary (File Uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AI Integration (OpenRouter for free Claude/GPT access)
# Get free API key from: https://openrouter.ai/keys
CLAUDE_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxx

# Google OAuth (Social Login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email Service (SMTP) - Required for email queue to work
# Use Gmail, SendGrid, AWS SES, or any SMTP provider
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@hireiq.com

# Server Configuration
CLIENT_URL=http://localhost:3000
PORT=5000
NODE_ENV=development

# Error Tracking
SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx